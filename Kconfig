# =============================================================================
# Shared TLS Self-Test Support
# =============================================================================
menu "Shared TLS Self-Test Support"

config PQCP_TLS_SELFTEST
	bool "Enable shared TLS self-test helper"
	depends on PQCP_MLKEM && PQCP_MLDSA
	default y if PQCP_PROFILE_GATEWAY
	help
	  Enable the shared offline TLS self-test helper used by the TLS sample,
	  protocol benchmark sample, and dedicated ztest coverage.

	  This helper exercises the same PQC-heavy ML-KEM and ML-DSA flow across
	  those paths and emits structured PQCP_METRIC rows when requested.
	  PSA initialization inside the helper remains optional at runtime and is
	  only available in builds that also enable MBEDTLS_PSA_CRYPTO_C or TFM.

endmenu

# =============================================================================
# Boot Self-Verification
# =============================================================================
menu "Boot Self-Verification"

config PQCP_KAT_BOOT_VERIFY
	bool "Run primitive self-verification at boot"
	default n
	depends on PQCP_RNG_DETERMINISTIC_TEST
	help
	  When enabled, the module installs a SYS_INIT hook at the
	  APPLICATION level that exercises every enabled ML-KEM and ML-DSA
	  parameter set with a deterministic seed and verifies a full
	  keygen / encaps / decaps (KEM) or keygen / sign / verify (DSA)
	  roundtrip before the application starts running. If any primitive
	  fails its roundtrip, the module calls k_panic() so the system
	  cannot proceed with cryptographic services that have not
	  passed their power-on self-test.

	  This is the embedded equivalent of a FIPS power-on self-test
	  (POST). It uses the deterministic test RNG so the boot-time
	  seed material is reproducible and does not pull entropy from
	  the platform RNG before SYS_INIT completes; that is why the
	  option depends on PQCP_RNG_DETERMINISTIC_TEST. After the
	  self-verify completes, callers MUST re-seed via
	  pqcp_rng_register() before serving production traffic.

	  Off by default because it pulls in the deterministic RNG and
	  changes boot semantics. Consumers that want a self-checking
	  module turn this on explicitly.

endmenu

# =============================================================================
# Benchmarking Configuration
# =============================================================================
menu "Benchmarking Configuration"

config PQCP_BENCH
	bool "Enable benchmarking support"
	default n
	select PQCP_TLS_SELFTEST
	help
	  Enable the PQCP benchmarking harness for measuring performance
	  of cryptographic operations.

if PQCP_BENCH

config PQCP_BENCH_ITERATIONS
	int "Number of benchmark iterations"
	default 100
	range 1 10000
	help
	  Number of iterations for each benchmark measurement.
	  Higher values provide more accurate averages but take longer.

config PQCP_BENCH_WARMUP
	int "Number of warmup iterations"
	default 10
	range 0 100
	help
	  Number of warmup iterations before starting measurements.
	  This helps stabilize caches and branch predictors.

config PQCP_BENCH_DISTRIBUTION_SAMPLES
	int "Number of retained benchmark samples for distribution metrics"
	default 128
	range 8 1024
	help
	  Number of per-operation timing samples retained for additive
	  distribution metrics such as median, p90, p99, and median absolute
	  deviation. The benchmark still runs CONFIG_PQCP_BENCH_ITERATIONS
	  iterations; this setting only caps the RAM used to retain raw timing
	  samples for publication-quality summaries.

config PQCP_BENCH_STACK_ANALYSIS
	bool "Stack usage analysis"
	depends on THREAD_STACK_INFO
	default y
	help
	  Enable stack usage analysis during benchmarks.
	  Requires Zephyr stack monitoring support.

config PQCP_BENCH_CYCLE_COUNTER
	bool "Use cycle counter for timing"
	default y if CPU_CORTEX_M_HAS_DWT
	help
	  Use hardware cycle counter for precise timing measurements.
	  Falls back to k_cyc_to_us_floor32() if unavailable.

config PQCP_BENCH_PROTOCOL
	bool "Protocol-level benchmarks"
	depends on NET_TCP || NET_UDP
	default n
	help
	  Enable protocol-level benchmarks (TLS/DTLS handshakes).
	  Requires networking support.

config PQCP_BENCH_PROTOCOL_RTOS_METRICS
	bool "RTOS-aware protocol benchmark metrics"
	default n
	help
	  Add opt-in scheduler/interrupt context metrics to the offline protocol
	  benchmark harness. When enabled, the benchmark spawns a lightweight
	  background load thread and periodic timer so the emitted PQCP_METRIC
	  stream can capture timer ISR counts, yield counts, and wake-up jitter
	  while the PQC handshake runs.

	  This option is intended for manual cost-of-assurance experiments and is
	  kept disabled by default so existing CI and product-style builds keep
	  their stable behavior.

if PQCP_BENCH_PROTOCOL_RTOS_METRICS

config PQCP_BENCH_PROTOCOL_RTOS_LOAD_PERIOD_MS
	int "RTOS load period (ms)"
	default 2
	range 1 1000
	help
	  Period for the background benchmark load thread and timer ISR probe.
	  Lower values increase the amount of RTOS scheduling pressure applied
	  during each handshake measurement.

config PQCP_BENCH_PROTOCOL_RTOS_LOAD_BUSY_WAIT_US
	int "RTOS load busy-wait per wake-up (us)"
	default 250
	range 0 100000
	help
	  Busy-wait time performed by the background load thread after each wake-up.
	  This keeps the RTOS-aware benchmark mode lightweight but observable on
	  qemu_x86_64 and supported MCU boards during manual experiments.

endif # PQCP_BENCH_PROTOCOL_RTOS_METRICS

endif # PQCP_BENCH
endmenu

