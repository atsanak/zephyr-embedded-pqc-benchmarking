# =============================================================================
# RNG Configuration
# =============================================================================
menu "Random Number Generator Configuration"

choice PQCP_RNG_MODE
	prompt "RNG Backend"
	default PQCP_RNG_ZEPHYR_ENTROPY

config PQCP_RNG_ZEPHYR_ENTROPY
	bool "Zephyr Entropy (sys_csrand_get)"
	depends on ENTROPY_GENERATOR
	help
	  Use Zephyr's cryptographically secure random number generator
	  (sys_csrand_get) which is backed by hardware entropy sources.
	  This is the recommended option for production use.

config PQCP_RNG_PSA
	bool "PSA Crypto RNG"
	depends on MBEDTLS_PSA_CRYPTO_C || BUILD_WITH_TFM
	help
	  Use PSA Crypto's psa_generate_random() for random number generation.
	  This option is useful when PSA Crypto is already in use.

config PQCP_RNG_CUSTOM
	bool "Custom RNG (application-provided)"
	help
	  Allow application to register a custom RNG implementation.
	  The application must call pqcp_rng_register() before using
	  any PQCP cryptographic operations.

endchoice

config PQCP_RNG_DETERMINISTIC_TEST
	bool "Deterministic RNG for testing (DANGEROUS)"
	depends on PQCP_RNG_CUSTOM
	help
	  WARNING: This option is for testing and ACVP validation ONLY.
	  DO NOT enable this in production builds.

	  Enables a deterministic DRBG that can be seeded with known values
	  for Known Answer Tests (KAT) and ACVP test vectors.

endmenu

# =============================================================================
# Backend Configuration
# =============================================================================
menu "Implementation Backend Configuration"

choice PQCP_IMPLEMENTATION_PROVIDER
	prompt "Cryptographic provider family"
	default PQCP_IMPLEMENTATION_PQCP

config PQCP_IMPLEMENTATION_PQCP
	bool "PQ Code Package (default)"
	help
	  Use the in-tree PQ Code Package implementations (`mlkem-native` and
	  `mldsa-native`). This is the production-oriented default and the only
	  provider family validated across the full MCU profile and PSA paths.

config PQCP_IMPLEMENTATION_BASELINE
	bool "Baseline native-C reference provider (QEMU only)"
	depends on BOARD_QEMU_X86_64
	depends on ((PQCP_MLKEM_LEVEL_512 && !PQCP_MLKEM_LEVEL_768 && !PQCP_MLKEM_LEVEL_1024) || \
		    (PQCP_MLKEM_LEVEL_768 && !PQCP_MLKEM_LEVEL_512 && !PQCP_MLKEM_LEVEL_1024) || \
		    (PQCP_MLKEM_LEVEL_1024 && !PQCP_MLKEM_LEVEL_512 && !PQCP_MLKEM_LEVEL_768))
	depends on ((PQCP_MLDSA_LEVEL_44 && !PQCP_MLDSA_LEVEL_65 && !PQCP_MLDSA_LEVEL_87) || \
		    (PQCP_MLDSA_LEVEL_65 && !PQCP_MLDSA_LEVEL_44 && !PQCP_MLDSA_LEVEL_87) || \
		    (PQCP_MLDSA_LEVEL_87 && !PQCP_MLDSA_LEVEL_44 && !PQCP_MLDSA_LEVEL_65))
	depends on !PQCP_MLKEM_MULTI_LEVEL && !PQCP_MLDSA_MULTI_LEVEL
	help
	  Use the portable C backend paths from mlkem-native and mldsa-native for
	  host-side cost-of-assurance comparisons on qemu_x86_64. The current
	  baseline provider supports single-level ML-KEM-512 / ML-KEM-768 /
	  ML-KEM-1024 and single-level ML-DSA-44 / ML-DSA-65 / ML-DSA-87 builds
	  behind the same Zephyr-facing APIs as the production PQCP provider family.

	  This option is intentionally limited to QEMU comparison runs. It is not a
	  production provider family, does not participate in PSA-driver validation,
	  and must not be used to justify deterministic RNG or MCU-only shortcuts in
	  production-style benchmarking.

endchoice

choice PQCP_BACKEND
	prompt "Implementation Backend"
	default PQCP_BACKEND_AUTO

config PQCP_BACKEND_AUTO
	bool "Automatic (detect ISA features)"
	depends on PQCP_IMPLEMENTATION_PQCP
	help
	  Automatically select the best available backend based on detected
	  ISA features at compile time. Uses native assembly backends when
	  available (AArch64 NEON, x86-64 AVX2, RISC-V RVV) and falls back
	  to portable C otherwise.

config PQCP_BACKEND_FORCE_C
	bool "Force portable C backend"
	depends on PQCP_IMPLEMENTATION_PQCP
	help
	  Force use of the portable C backend even when native backends
	  are available. This is useful for testing and comparison purposes.

config PQCP_BACKEND_FORCE_NATIVE
	bool "Force native backend (advanced)"
	depends on PQCP_IMPLEMENTATION_PQCP
	help
	  Force use of native assembly backends. This may cause build
	  failures or runtime errors on unsupported architectures.
	  Only use this if you know your target supports the required
	  ISA extensions.

config PQCP_BACKEND_CLEAN
	bool "Native-C/reference backend label"
	depends on PQCP_IMPLEMENTATION_BASELINE
	help
	  Metadata-only backend label used by the QEMU baseline implementation
	  family in cost-of-assurance experiments. The baseline provider uses the
	  portable C backend paths from mlkem-native and mldsa-native, so this
	  option exists mainly to keep benchmark metadata explicit and comparable
	  to the PQCP provider family.

endchoice

config PQCP_FIPS202_EXTERNAL
	bool "Use external FIPS-202 implementation"
	default n
	help
	  Use an external SHA-3/SHAKE implementation instead of the one
	  bundled with mlkem-native and mldsa-native. This allows sharing
	  a single FIPS-202 implementation across the system.

config PQCP_LIBOQS_EXPERIMENTAL
	bool "Enable experimental external-provider inventory"
	default n
	help
	  Enable metadata for optional schemes that are outside the native
	  provider families. This option is inventory and policy plumbing only:
	  it is not a production default, does not change the existing crypto
	  APIs, and does not select an implementation for the native families.

config PQCP_REDUCE_RAM
	bool "Reduced RAM mode"
	default n
	help
	  Enable reduced RAM mode which trades performance for lower
	  memory usage. This is useful on very constrained devices.

endmenu

# =============================================================================
# Provider Contract Reporting
# =============================================================================
menu "Provider Contract Reporting"

config PQCP_PROVIDER_CONTRACT
	bool "Enable provider contract reporting"
	default y
	help
	  Enable firmware-visible provider contract helpers. These helpers report
	  which provider family and backend selector were compiled into the image
	  and validate that native ML-KEM and ML-DSA families are still bound to
	  the PQ Code Package native sources.

	  This option is evidence plumbing only. It does not select an
	  implementation, import external code, or change cryptographic behavior.

endmenu

# =============================================================================
# Firmware Build Manifest
# =============================================================================
menu "Firmware Build Manifest"

config PQCP_BUILD_MANIFEST
	bool "Enable firmware build manifest reporting"
	default y
	help
	  Enable C helpers that report the firmware-visible build manifest:
	  PQCP version, Zephyr version, board, enabled PQC level masks, selected
	  profiles, RNG mode, and provider-contract availability. The emitted
	  PQCP_BUILD_MANIFEST marker is intended for QEMU/device transcripts and
	  release evidence binding.

	  This option does not select cryptographic algorithms and does not change
	  ACVP, benchmark, or public crypto API behavior.

endmenu

# =============================================================================
# Firmware Evidence Session
# =============================================================================
menu "Firmware Evidence Session"

config PQCP_EVIDENCE_SESSION
	bool "Enable firmware evidence session markers"
	default y
	help
	  Enable C helpers that wrap firmware-visible evidence output in a
	  begin/event/end session. The session records which high-level evidence
	  markers were required, which were observed, and whether any marker failed
	  or appeared twice. The emitted PQCP_EVIDENCE_SESSION_* markers make QEMU
	  or device transcripts easier to replay for completeness.

	  This option is evidence plumbing only. It does not select cryptographic
	  algorithms and does not change ACVP, benchmark, or public crypto API
	  behavior.

endmenu

# =============================================================================
# Firmware Evidence Transcript Replay
# =============================================================================
menu "Firmware Evidence Transcript Replay"

config PQCP_EVIDENCE_TRANSCRIPT
	bool "Enable firmware evidence transcript replay verifier"
	depends on PQCP_ASSURANCE_STATUS && PQCP_EVIDENCE_SESSION
	default n
	help
	  Enable a small C replay verifier for the stable firmware evidence
	  transcript grammar. The verifier consumes captured UART/QEMU transcript
	  lines, validates hashes and nonce fields, and cross-checks
	  PQCP_EVIDENCE_SESSION_* summaries against the concrete evidence markers
	  that actually appeared in the transcript.

	  This option is evidence plumbing only. It does not select cryptographic
	  algorithms and does not change ACVP, benchmark, or public crypto API
	  behavior.

endmenu

# =============================================================================
# Firmware Policy Evidence
# =============================================================================
menu "Firmware Policy Evidence"

config PQCP_FIRMWARE_POLICY
	bool "Enable firmware policy/readiness evidence"
	depends on PQCP_BUILD_MANIFEST && PQCP_PROVIDER_CONTRACT
	default y
	help
	  Enable C helpers that evaluate firmware-visible profile, provider,
	  algorithm-level, and RNG constraints and emit a stable
	  PQCP_FIRMWARE_POLICY marker. The marker records whether the local image
	  satisfies its derived firmware policy and, on failure, exposes a blocker
	  bit mask for transcript replay.

	  This option is evidence plumbing only. It does not select cryptographic
	  algorithms and does not change ACVP, benchmark, or public crypto API
	  behavior.

endmenu

