endmenu

# =============================================================================
# Firmware Scorecard Evidence
# =============================================================================
menu "Firmware Scorecard Evidence"

config PQCP_FIRMWARE_SCORECARD
	bool "Enable firmware evidence scorecard"
	depends on PQCP_ASSURANCE_STATUS && PQCP_BUILD_MANIFEST
	depends on PQCP_PROVIDER_CONTRACT && PQCP_FIRMWARE_POLICY
	depends on PQCP_CAPABILITY_DESCRIPTOR && PQCP_EVIDENCE_SESSION
	default y
	help
