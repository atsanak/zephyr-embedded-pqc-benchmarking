# PQCP Zephyr Trust Stack - Kconfig Configuration
#
# Post-Quantum Cryptography Package for Zephyr RTOS
# Implements ML-KEM (FIPS-203) and ML-DSA (FIPS-204)

menuconfig PQCP
	bool "PQ Code Package - Post-Quantum Cryptography"
	help
	  Enable the PQ Code Package post-quantum cryptography module.
	  This provides ML-KEM (FIPS-203) and ML-DSA (FIPS-204) implementations
	  using mlkem-native and mldsa-native libraries.

if PQCP

# =============================================================================
# ML-KEM (FIPS-203) Configuration
# =============================================================================
menu "ML-KEM (FIPS-203) Configuration"

config PQCP_MLKEM
	bool "Enable ML-KEM support"
	default y
	help
	  Enable ML-KEM (Module-Lattice Key Encapsulation Mechanism) support.
	  ML-KEM is standardized in FIPS-203.

if PQCP_MLKEM

config PQCP_MLKEM_LEVEL_512
	bool "ML-KEM-512 (NIST Level 1)"
	default n
	help
	  Enable ML-KEM-512 providing NIST security level 1.
	  Public key: 800 bytes, Ciphertext: 768 bytes.

config PQCP_MLKEM_LEVEL_768
	bool "ML-KEM-768 (NIST Level 3)"
	default y
	help
	  Enable ML-KEM-768 providing NIST security level 3.
	  Public key: 1184 bytes, Ciphertext: 1088 bytes.
	  This is the recommended default for most applications.

config PQCP_MLKEM_LEVEL_1024
	bool "ML-KEM-1024 (NIST Level 5)"
	default n
	help
	  Enable ML-KEM-1024 providing NIST security level 5.
	  Public key: 1568 bytes, Ciphertext: 1568 bytes.

config PQCP_MLKEM_MULTI_LEVEL
	bool "Multi-level ML-KEM build"
	default n
	help
	  Build a single library that supports multiple ML-KEM security levels
	  at runtime. This increases code size but allows runtime level selection.

config PQCP_MLKEM_MONOLITHIC
	bool "Monolithic ML-KEM build (single translation unit)"
	default n
	depends on !SOC_FAMILY_ARM
	help
	  Build ML-KEM as a single translation unit for potential LTO benefits.
	  This is primarily useful for host/native_sim builds and is not
	  recommended for MCU targets due to increased peak memory during
	  compilation.

endif # PQCP_MLKEM
endmenu

# =============================================================================
# ML-DSA (FIPS-204) Configuration
# =============================================================================
menu "ML-DSA (FIPS-204) Configuration"

config PQCP_MLDSA
	bool "Enable ML-DSA support"
	default y
	help
	  Enable ML-DSA (Module-Lattice Digital Signature Algorithm) support.
	  ML-DSA is standardized in FIPS-204.

if PQCP_MLDSA

config PQCP_MLDSA_LEVEL_44
	bool "ML-DSA-44 (NIST Level 2)"
	default n
	help
	  Enable ML-DSA-44 providing NIST security level 2.
	  Public key: 1312 bytes, Signature: 2420 bytes.

config PQCP_MLDSA_LEVEL_65
	bool "ML-DSA-65 (NIST Level 3)"
	default y
	help
	  Enable ML-DSA-65 providing NIST security level 3.
	  Public key: 1952 bytes, Signature: 3293 bytes.
	  This is the recommended default for most applications.

config PQCP_MLDSA_LEVEL_87
	bool "ML-DSA-87 (NIST Level 5)"
	default n
	help
	  Enable ML-DSA-87 providing NIST security level 5.
	  Public key: 2592 bytes, Signature: 4595 bytes.

config PQCP_MLDSA_MULTI_LEVEL
	bool "Multi-level ML-DSA build"
	default n
	help
	  Build a single library that supports multiple ML-DSA security levels
	  at runtime. This increases code size but allows runtime level selection.

config PQCP_MLDSA_STREAMING
	bool "ML-DSA streaming API"
	default y
	help
	  Enable streaming hash-based signing for large messages. This allows
	  signing messages that exceed available RAM by processing in chunks.

config PQCP_MLDSA_MONOLITHIC
	bool "Monolithic ML-DSA build (single translation unit)"
	default n
	depends on !SOC_FAMILY_ARM
