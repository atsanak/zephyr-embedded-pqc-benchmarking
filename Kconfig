# =============================================================================
# Build Profiles
# =============================================================================
menu "Build Profiles"

config PQCP_PROFILE_MCU_MINIMAL
	bool "MCU Minimal Profile"
	select PQCP_MLKEM_LEVEL_768
	select PQCP_MLDSA_LEVEL_65
	help
	  Minimal profile for constrained MCUs.
	  Enables only ML-KEM-768 and ML-DSA-65 (NIST Level 3).
	  Uses Zephyr entropy RNG. No lab/test features.
	  Suitable for production firmware on Cortex-M devices.

config PQCP_PROFILE_GATEWAY
	bool "Gateway Profile"
	select PQCP_MLKEM_LEVEL_512
	select PQCP_MLKEM_LEVEL_768
	select PQCP_MLKEM_LEVEL_1024
	select PQCP_MLKEM_MULTI_LEVEL
