config PQCP_CAPABILITY_DESCRIPTOR
	bool "Enable firmware capability descriptor"
	depends on PQCP_BUILD_MANIFEST && PQCP_PROVIDER_CONTRACT
	depends on PQCP_FIRMWARE_POLICY
	default y
	help
	  Enable a compact C descriptor that summarizes firmware-visible PQC
	  capability, provider-family policy, profile readiness, and compiled
	  evidence plumbing in a stable PQCP_CAPABILITY_DESCRIPTOR marker. This is
	  intended for QEMU/device transcripts and partner review; it is not a
